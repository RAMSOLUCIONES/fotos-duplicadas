{
  "expo": {
    "name": "Fotos Duplicadas",
    "slug": "fotos-duplicadas",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "android": {
      "package": "com.fotosduplicadas.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Necesito acceder a tus fotos y videos para encontrar los duplicados.",
          "savePhotosPermission": "Necesito permiso para mover tus fotos y videos a otra carpeta.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
